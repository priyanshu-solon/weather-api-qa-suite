    {
      "name": "Weather Tests (Open-Meteo)",
      "item": [
        {
          "name": "GET - Valid Coordinates (Get Weather)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Weather exists\", () => {\r",
                  "    pm.expect(res).to.have.property(\"current_weather\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{weather_url}}/v1/forecast?latitude={{lat}}&longitude={{lon}}&current_weather=true",
              "host": [
                "{{weather_url}}"
              ],
              "path": [
                "v1",
                "forecast"
              ],
              "query": [
                {
                  "key": "latitude",
                  "value": "{{lat}}"
                },
                {
                  "key": "longitude",
                  "value": "{{lon}}"
                },
                {
                  "key": "current_weather",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "End-to-End Flow",
      "item": [
        {
          "name": "GET - City → Weather (Chained Flow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"End-to-End flow works\", () => {\r",
                  "    const lat = pm.environment.get(\"lat\");\r",
                  "    const lon = pm.environment.get(\"lon\");\r",
                  "\r",
                  "    pm.expect(lat).to.exist;\r",
                  "    pm.expect(lon).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Weather API Success\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Temperature exists\", function () {\r",
                  "    let json = pm.response.json();\r",
                  "    pm.expect(json.current_weather).to.have.property(\"temperature\");\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.open-meteo.com/v1/forecast?latitude={{lat}}&longitude={{lon}}&current_weather=true",
              "protocol": "https",
              "host": [
                "api",
                "open-meteo",
                "com"
              ],
              "path": [
                "v1",
                "forecast"
              ],
              "query": [
                {
                  "key": "latitude",
                  "value": "{{lat}}"
                },
                {
                  "key": "longitude",
                  "value": "{{lon}}"
                },
                {
                  "key": "current_weather",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
