  "item": [
    {
      "name": "Geocoding Test (Nominatim)",
      "item": [
        {
          "name": "GET - Valid City (Get Coordinates)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "// check API success\r",
                  "pm.test(\"Status is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// check response type\r",
                  "pm.test(\"Response is array\", () => {\r",
                  "    pm.expect(res).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "// save coordinates\r",
                  "if (res.length > 0) {\r",
                  "    pm.environment.set(\"lat\", res[0].lat);\r",
                  "    pm.environment.set(\"lon\", res[0].lon);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "weather-intel-app (priyanshusolon2001@gmail.com)",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{geo_url}}/search?q={{city}}&format=json",
              "host": [
                "{{geo_url}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{city}}"
                },
                {
                  "key": "format",
                  "value": "json"
                }
              ]
            }
          },
          "response": []
        },
